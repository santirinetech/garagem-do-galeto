# ==========================================
# VARIÁVEIS DE AMBIENTE - GARAGEM DO GALETO
# ==========================================

# [Servidor]

PORT=3000
NODE_ENV=production

# [Aplicação]

# URL pública utilizada pelo Electron e integrações.
APP_URL=https://www.garagemdomarcao.online

# [Segurança]

# Gere uma string aleatória forte para assinar os cookies de sessão.
SESSION_SECRET=sua_chave_secreta_super_segura_aqui

# [Administrador / Scripts]

ADMIN_USER=
ADMIN_PASSWORD=

# [Banco de Dados]

# Caminho para o banco SQLite em produção (opcional)
# DB_PATH=./loja.db

# [WhatsApp]

# Integração opcional. Deve permanecer desligada por padrão.
ENABLE_WHATSAPP=false
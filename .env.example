# ==========================================
# VARIÁVEIS DE AMBIENTE - GARAGEM DO GALETO
# ==========================================

# [Servidor]
PORT=3000
NODE_ENV=production

# [Segurança]
# Gere uma string aleatória forte para assinar os cookies de sessão.
# Exemplo: use o comando 'crypto.randomBytes(64).toString("hex")' no Node.
SESSION_SECRET=sua_chave_secreta_super_segura_aqui

# [Banco de Dados]
# Caminho para o banco SQLite em produção (opcional se quiser sobrescrever)
# DB_PATH=./loja.db

# [WhatsApp Bot / Railway]
# Habilita a inicialização do robô do WhatsApp no ambiente de nuvem
ENABLE_WHATSAPP=true

# Dependências exigidas pelo Puppeteer no Railway (usar no painel do Railway ou nixpacks.toml)
# NIXPACKS_APT_PKGS=wget gnupg libnss3 libatk-bridge2.0-0 libx11-xcb1 libxcb-dri3-0 libxcomposite1 libxcursor1 libxdamage1 libxfixes3 libxi6 libxrandr2 libgbm1 libasound2 libpangocairo-1.0-0 libpango-1.0-0 libatk1.0-0 libcups2 libdrm2 libxshmfence1 chromium libxss1 libglib2.0-0 libxkbcommon0

# ==========================================
# VARIÁVEIS DE AMBIENTE - GARAGEM DO GALETO
# ==========================================

# [Servidor]
PORT=3000
NODE_ENV=production

# [Segurança]
# Gere uma string aleatória forte para assinar os cookies de sessão.
# Exemplo: use o comando 'crypto.randomBytes(64).toString("hex")' no Node.
SESSION_SECRET=sua_chave_secreta_super_segura_aqui

# [Banco de Dados]
# Caminho para o banco SQLite em produção (opcional se quiser sobrescrever)
# DB_PATH=./loja.db

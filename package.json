{
  "name": "galeto-system",
  "version": "1.0.0",
  "description": "Sistema Garagem do Galeto",
  "main": "src/main/main.js",
  "scripts": {
    "start": "node src/server.js",
    "electron": "electron .",
    "dev": "nodemon src/server.js",
    "desktop": "electron .",
    "dist": "electron-builder --win --x64",
    "db:reset": "node scripts/reset-banco-prod.js"
  },
  "build": {
    "appId": "com.santirine.galetomaster",
    "productName": "Galeto Master",
    "copyright": "Copyright © 2026 Santirine Tech",
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "GaletoMaster-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Galeto Master"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "connect-sqlite3": "^0.9.16",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "pg": "^8.21.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.6",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  }
}

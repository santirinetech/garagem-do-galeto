{
  "name": "galeto-system",
  "version": "1.0.0",
  "description": "Sistema Garagem do Galeto",
  "main": "src/main/main.js",
  "scripts": {
    "start":       "electron .",
    "server":      "node server-standalone.js",
    "dev":         "nodemon server-standalone.js",
    "dist":        "electron-builder --win --x64",
    "db:clean":    "node scripts/limpar-banco.js",
    "db:clean:run":"node scripts/limpar-banco.js --confirmar",
    "lint:deps":   "npx depcheck --ignores=electron,electron-builder,nodemon"
  },
  "build": {
    "appId": "com.santirine.galetomaster",
    "productName": "Galeto Master",
    "copyright": "Copyright © 2026 Santirine Tech",
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      "server-standalone.js",
      "loja.db"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "GaletoMaster-Setup-${version}.${ext}"
    },
    "extraResources": [
      "loja.db"
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Galeto Master"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "multer": "^2.1.1",
    "qrcode": "^1.5.4",
    "sqlite3": "^5.1.6",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  }
}
